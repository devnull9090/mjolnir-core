{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mjolnir.dev/schemas/level.schema.json",
  "title": "MJOLNIR level",
  "description": "A custom level authored as a map variant over a shipped scenario. See docs/level_format.md.",
  "type": "object",
  "required": ["schema_version", "name", "canvas"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
    "title": { "type": "string", "maxLength": 128 },
    "author": { "type": "string", "maxLength": 128 },
    "description": { "type": "string", "maxLength": 1024 },
    "kill_floor": {
      "type": ["number", "null"],
      "description": "Absolute Unreal Z in centimetres below which the host kills players. Omit for no map-specific override; the level loader enforces it."
    },
    "canvas": {
      "type": "object",
      "required": ["scenario", "origin"],
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "enum": ["A15", "A30", "A50", "B30", "B40", "C10", "C20", "C45", "D20", "D40", "E10", "E20", "E30"]
        },
        "origin": { "$ref": "#/$defs/vec3" }
      }
    },
    "environment": {
      "description": "Sky and lighting the loader spawns into a bare canvas world.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sun": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pitch": { "$ref": "#/$defs/degrees" },
            "yaw": { "$ref": "#/$defs/degrees" },
            "intensity": { "type": "number", "minimum": 0 }
          }
        },
        "skylight": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "intensity": { "type": "number", "minimum": 0 } }
        },
        "atmosphere": { "type": "boolean" }
      }
    },
    "blam": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "if": { "anyOf": [
          { "required": ["forge_packs"], "properties": { "forge_packs": { "minItems": 1 } } },
          { "required": ["forge_objects"], "properties": { "forge_objects": { "minItems": 1 } } }
        ] },
        "then": { "required": ["map_variant"], "properties": { "map_variant": { "const": true } } }
      }],
      "properties": {
        "map_variant": { "type": "boolean", "default": false },
        "forge_packs": {
          "type": "array", "maxItems": 63,
          "description": "Exact pack dependencies and palette order for a standalone bake. CLI also checks namespaced tag identity, unique IDs, at most 200 custom references total and the 255-entry combined palette limit.",
          "items": {
            "type": "object", "required": ["slug", "version", "blocks"], "additionalProperties": false,
            "properties": {
              "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
              "version": {
                "type": "string", "maxLength": 96,
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
              },
              "blocks": {
                "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true,
                "items": {
                  "type": "object", "required": ["id", "tag"], "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
                    "tag": { "type": "string", "pattern": "^objects\\\\mjolnir\\\\forge\\\\[a-z0-9][a-z0-9-]{1,63}\\\\[a-z0-9][a-z0-9_-]{0,63}$" }
                  }
                }
              }
            }
          }
        },
        "forge_objects": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "description": "Existing scenery/crate tags to add to the standalone Forge palette without preplacing them. Custom pack objects must use forge_packs.",
          "items": {
            "type": "object", "required": ["group", "tag"], "additionalProperties": false,
            "properties": {
              "group": { "enum": ["scenery", "crates"] },
              "tag": {
                "type": "string", "maxLength": 223,
                "pattern": "^objects(?:\\\\[a-z0-9_-]+)+$",
                "not": { "pattern": "^objects\\\\mjolnir\\\\forge\\\\" }
              }
            }
          }
        },
        "clear": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "squads": { "type": "boolean", "default": false },
            "bipeds": { "type": "boolean", "default": false },
            "weapons": { "type": "boolean", "default": false },
            "vehicles": { "type": "boolean", "default": false },
            "equipment": { "type": "boolean", "default": false },
            "scripts": { "type": "boolean", "default": false }
          }
        },
        "player_starts": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["pos"],
            "additionalProperties": false,
            "properties": {
              "pos": { "$ref": "#/$defs/vec3" },
              "yaw": { "$ref": "#/$defs/degrees" }
            }
          }
        },
        "vehicles": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/typedPlacement" }
        },
        "weapons": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/typedPlacement" }
        },
        "equipment": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/typedPlacement" }
        },
        "script": { "type": "string" },
        "object_names": { "type": "array", "maxItems": 2048, "items": { "type": "string", "minLength": 1, "maxLength": 127 } },
        "device_groups": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "maxLength": 31 },
              "initial_value": { "type": "number" },
              "flags": { "type": "integer" }
            }
          }
        },
        "trigger_volumes": {
          "type": "array",
          "maxItems": 350,
          "items": {
            "type": "object",
            "required": ["name", "pos", "forward", "up", "extents"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "pos": { "$ref": "#/$defs/vec3" },
              "forward": { "$ref": "#/$defs/vec3" },
              "up": { "$ref": "#/$defs/vec3" },
              "extents": { "$ref": "#/$defs/vec3" }
            }
          }
        },
        "cutscene_flags": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": ["pos"],
            "additionalProperties": false,
            "properties": {
              "pos": { "$ref": "#/$defs/vec3" },
              "yaw": { "type": "number" },
              "pitch": { "type": "number" },
              "name": { "type": "string" }
            }
          }
        },
        "objects": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": ["tag", "group", "pos"],
            "additionalProperties": false,
            "properties": {
              "tag": { "type": "string", "pattern": "^objects\\\\", "maxLength": 256 },
              "group": { "enum": ["scenery", "crates", "machines", "controls"] },
              "pos": { "$ref": "#/$defs/vec3" },
              "rot": { "$ref": "#/$defs/rot3" },
              "name": { "type": "string", "minLength": 1, "maxLength": 127 },
              "placed": { "type": "boolean" },
              "power_group": { "type": "string" },
              "position_group": { "type": "string" },
              "set": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    },
    "decor": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["id", "mesh", "pos"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
          "mesh": { "type": "string", "pattern": "^/(Engine|Game)/", "maxLength": 256 },
          "pos": { "$ref": "#/$defs/vec3" },
          "rot": { "$ref": "#/$defs/rot3" },
          "scale": { "$ref": "#/$defs/vec3" },
          "tint": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "materials": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(|/(Engine|Game)/.+)$"
            }
          }
        }
      }
    },
    "markers": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["name", "pos"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
          "pos": { "$ref": "#/$defs/vec3" },
          "yaw": { "$ref": "#/$defs/degrees" }
        }
      }
    },
    "multiplayer": {
      "type": "boolean",
      "description": "Start the map under the Megalo engine (MJOLNIRLevelLoader's native half)."
    },
    "variant": {
      "type": "string",
      "description": "The game type a map starts with when none is chosen, a variants/<name>.mglo the loader ships."
    },
    "modes": {
      "type": "array",
      "description": "The game types the multiplayer menu offers for the map.",
      "items": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" }
    },
    "ctf": {
      "type": "object",
      "description": "Capture the Flag's look for the loader: the flag mesh, its team materials, the stands."
    },
    "health_pack": {
      "type": "object",
      "description": "The CE health pack's look for the loader: mesh, pos and scale on the pack's actor, materials."
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "rot3": {
      "description": "[pitch, yaw, roll] in degrees, UE convention",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": -360, "maximum": 360 }
    },
    "degrees": { "type": "number", "minimum": -360, "maximum": 360 },
    "typedPlacement": {
      "type": "object",
      "required": ["type", "pos"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
        "pos": { "$ref": "#/$defs/vec3" },
        "yaw": { "$ref": "#/$defs/degrees" },
        "set": {
          "type": "object",
          "description": "Further fields of the placement, relative to its element, e.g. the Warthog's rocket turret: {\"permutation data.variant name\": \"rocket\"}",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
