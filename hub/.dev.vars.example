# MJOLNIR Hub - Environment Variables
# Copy this file to .dev.vars and fill in real values
# NEVER commit .dev.vars to git
#
# The same names exist as GitHub Actions secrets; deploy-hub.yml uploads them
# to the Worker's secret store on every deploy.

DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret
DISCORD_PUBLIC_KEY=your_discord_app_public_key
JWT_SECRET=generate_a_random_32_char_string_here

# Optional dev overrides for testing /code-mods/sync against a locally
# served, throwaway-key-signed manifest (never set in production):
# CODE_MODS_BASE=http://localhost:8787
# CODE_MODS_PUB_B64=<spki der base64 of the throwaway public key>
