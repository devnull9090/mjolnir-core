{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "sync:tags": "node scripts/sync-tag-defs.mjs",
    "sync:console": "node scripts/sync-console-defs.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "sync:blog": "node scripts/sync-blog.mjs",
    "sync": "node scripts/sync-docs.mjs && node scripts/sync-tag-defs.mjs && node scripts/sync-console-defs.mjs && node scripts/sync-changelog.mjs && node scripts/sync-blog.mjs",
    "sync:check": "npm run sync && node scripts/check-sync-drift.mjs",
    "dev": "npm run sync && next dev",
    "build": "npm run sync && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-match-chat.mts && tsx scripts/test-benches.mts",
    "conformance:signing": "cargo run -q -p mjolnir-sign --example fixture > .signing-fixture.json && tsx scripts/verify-fixture.mts .signing-fixture.json",
    "openapi:export": "tsx scripts/export-openapi.mts",
    "openapi:check": "tsx scripts/export-openapi.mts && git diff --exit-code -- public/openapi.json",
    "db:migrate": "wrangler d1 migrations apply mjolnir-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply mjolnir-db --remote",
    "cf:build": "npx @opennextjs/cloudflare build",
    "preview": "npm run cf:build && npx wrangler dev",
    "deploy": "npm run cf:build && npx wrangler deploy"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.11",
    "lucide-react": "^1.27.0",
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.30.1",
      "proxy-addr": "^2.0.8",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "nanoid@3": "^3.3.18",
      "js-yaml@4": "^4.3.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "glob@10": "^10.5.0",
      "qs@6": "^6.16.0"
    }
  }
}
