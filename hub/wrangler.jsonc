{
  "name": "mjolnir-hub",
  "compatibility_date": "2025-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mjolnir-db",
      "database_id": "2bd39427-6b15-48aa-bce7-74913218e245",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MODS_BUCKET",
      "bucket_name": "mjolnir-mods"
    },
    {
      "binding": "RELEASES_BUCKET",
      "bucket_name": "mjolnir-releases"
    }
  ],
  "vars": {
    "SITE_URL": "https://mjolnircore.com",
    // Content uploads must carry a verifiable author signature: the
    // `unsigned` scan finding becomes an error rather than a warning.
    // Publishing therefore requires a tag editor that signs (0.3.0+).
    // Lives here rather than as a secret so the policy is visible and
    // deploys atomically with the worker (docs/mod_signing_design.md).
    "REQUIRE_SIGNED_UPLOADS": "1",
    // The platform's one super admin, by Discord snowflake. The OAuth
    // callback grants this account the admin role on every login, so the
    // seat survives database resets and works before first sign-in.
    "SUPER_ADMIN_DISCORD_ID": "867190209217429514"
  }
}