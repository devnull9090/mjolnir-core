{
  "name": "mjolnir-hub",
  "compatibility_date": "2025-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  // CPU per request, the most a Workers paid plan allows (default 30 s).
  // Publishing a release unzips and hashes its whole archive: Timberland
  // 2.1.0 (117 MiB, 202 MiB unpacked) took 32 s of CPU and was cut off
  // (exceededCpu, 2026-10-20). Ordinary requests take milliseconds.
  "limits": {
    "cpu_ms": 300000
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mjolnir-db",
      "database_id": "2bd39427-6b15-48aa-bce7-74913218e245",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MODS_BUCKET",
      "bucket_name": "mjolnir-mods"
    },
    {
      "binding": "RELEASES_BUCKET",
      "bucket_name": "mjolnir-releases"
    }
  ],
  // Semantic docs search (src/lib/api/docs-search.ts): Workers AI embeds the
  // docs' chunks and a query, Vectorize holds the vectors. The index has to
  // exist before a deploy that names it, or the deploy is refused:
  //   wrangler vectorize create mjolnir-docs --dimensions=1024 --metric=cosine
  // 1024 is what @cf/baai/bge-m3 embeds to; another model means another index.
  // `remote` is read by local dev only: neither has a local simulation, so a
  // dev session that asks for remote bindings (MJ_REMOTE_BINDINGS=1, see
  // next.config.ts) reaches the real ones, and any other leaves them unconnected.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "DOCS_INDEX",
      "index_name": "mjolnir-docs",
      "remote": true
    }
  ],
  "vars": {
    "SITE_URL": "https://mjolnircore.com",
    // Content uploads must carry a verifiable author signature: the
    // `unsigned` scan finding becomes an error rather than a warning.
    // Publishing therefore requires a tag editor that signs (0.3.0+).
    // Lives here rather than as a secret so the policy is visible and
    // deploys atomically with the worker (docs/mod_signing_design.md).
    "REQUIRE_SIGNED_UPLOADS": "1",
    // The mods bucket's public host. A release download redirects here
    // rather than streaming the archive through the Worker.
    "MODS_PUBLIC_URL": "https://user-content.mjolnircore.com",
    // The platform's one super admin, by Discord snowflake. The OAuth
    // callback grants this account the admin role on every login, so the
    // seat survives database resets and works before first sign-in.
    "SUPER_ADMIN_DISCORD_ID": "867190209217429514"
  }
}