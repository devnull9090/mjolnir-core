{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Shared with the hub website, compiled from source; mirrors the aliases
       in vite.config.ts. The `react` entries are what let that source — which
       sits outside this project and cannot walk up to these types — resolve
       them. See hub/src/kit/README.md. */
    "paths": {
      "@mjolnir/hub-kit": ["../../hub/src/kit/index.ts"],
      "@mjolnir/hub-kit/*": ["../../hub/src/kit/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src", "../../hub/src/kit"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
