        // A grazing road pixel can be long in the direction of travel while
        // still resolving individual stones across the carriageway.
        float groundDet=earthDx.x*earthDy.y-earthDx.y*earthDy.x;
        float inverseGroundDet=sign(groundDet)/max(abs(groundDet),1.e-9);
        float groundMajor=max(max(length(earthDx),length(earthDy)),.0001);
        float grainFoot=max(abs(groundDet)/groundMajor,.125*groundMajor);
        float visibleGrain=1.-smoothstep(.057,.14,grainFoot);
        float4 panelMean=float4(.401,.365,.332,.476);
        float4 chip=panelMean;
        [branch] if (visibleGrain>.001)
        {
            float2 lattice=rotated*1.57, lower=floor(lattice), f=frac(lattice);
            float2 middle=f.x>=f.y ? float2(1,0) : float2(0,1);
            float3 weights=float3(1.-max(f.x,f.y),abs(f.x-f.y),min(f.x,f.y));
            weights*=weights; weights/=dot(weights,float3(1.,1.,1.));
            float2 tile=float2(1008./2048.,1008./1024.);
            float4 material=0.;
            [unroll] for(int i=0;i<3;++i)
            {
                float2 vertex=lower+(i==0 ? float2(0,0) : (i==1 ? middle : float2(1,1)));
                uint2 id=asuint(int2(vertex));
                uint bits=(id.x*0x68bc21ebu)^(id.y*0x02e5be93u);
                bits^=bits>>16u; bits*=0x7feb352du; bits^=bits>>15u; bits*=0x846ca68bu; bits^=bits>>16u;
                float3 seed=float3(uint3(bits,bits>>10u,bits>>20u)&1023u)/1023.;
                float s,c; sincos(seed.z*6.2831853,s,c);
                float2x2 spin=float2x2(c,-s,s,c);
                float frequency=lerp(1.20,1.84,seed.y);
                float2 uv=mul(spin,lattice-vertex)*(frequency/1.57)+seed.xy;
                float2 gx=mul(spin,dX)*frequency, gy=mul(spin,dY)*frequency;
                float2 reach=.68*(abs(gx)+abs(gy));
                float lodLimit=min(1.,.19/max(.00001,max(reach.x,reach.y)));
                float2 inset=max(0.,reach*lodLimit-5./1008.), scale=1.-2.*inset;
                material+=weights[i]*Texture2DSampleGrad(SweepFloorDetail,SiteEarthSampler,
                    (frac(uv)*scale+inset)*tile+float2(8./2048.,8./1024.),
                    gx*scale*tile*lodLimit,gy*scale*tile*lodLimit);
            }
            chip=lerp(panelMean,material,visibleGrain);
        }
        // RGB is the original campaign stone colour. Alpha is scalar relief,
        // so derive its world-space slope after filtering and tile blending.
        float2 dh=float2(ddx(chip.a),ddy(chip.a))*.007;
        float2 chipN=-clamp(float2(earthDy.y*dh.x-earthDx.y*dh.y,
                                  earthDx.x*dh.y-earthDy.x*dh.x)*inverseGroundDet,-.50,.50);
