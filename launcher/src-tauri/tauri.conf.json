{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MJOLNIR-Launcher",
  "version": "0.1.1",
  "identifier": "com.devnull9090.mjolnir-launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MJOLNIR Core Launcher",
        "width": 1000,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mjolnircore.com/api/releases/latest"
      ]
    }
  }
}
